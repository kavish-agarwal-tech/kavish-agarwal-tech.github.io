---
import type { CaseStudy } from "../data/content";
import { withBase } from "../utils/paths";
interface Props { study: CaseStudy }
const { study } = Astro.props;
---
<article class="work-card">
  <div class="card-meta"><span>{study.eyebrow}</span><span>{study.tags[0]}</span></div>
  <h3>{study.title}</h3>
  <p>{study.summary}</p>
  <div class="tag-list">{study.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}</div>
  <a class="text-link" href={withBase(`/work/${study.slug}`)}>Read case study <span aria-hidden="true">↗</span></a>
</article>
