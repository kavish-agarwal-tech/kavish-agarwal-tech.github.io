---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { contact } from "../data/content";
import { withBase } from "../utils/paths";

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const { title, description } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const routePath = basePath && Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length) || "/"
  : Astro.url.pathname;
const canonical = new URL(`${basePath}${routePath}`, Astro.site ?? Astro.url);
const ogImage = new URL(`${basePath}/og.png`, Astro.site ?? Astro.url);
const pageTitle = title.includes("Kavish Agarwal") ? title : `${title} | Kavish Agarwal`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer contact={contact} />
  </body>
</html>
