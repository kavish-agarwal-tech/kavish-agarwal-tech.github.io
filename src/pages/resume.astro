---
import BaseLayout from "../layouts/BaseLayout.astro";
import { resumeCareer, resumeFocusAreas, credentials } from "../data/content";
import { withBase } from "../utils/paths";
import resumePdf from "../../docs/Kavish_Agarwal_Resume.pdf";
---
<BaseLayout title="Resume" description="Public resume for Kavish Agarwal, technology leader, enterprise architect, principal engineer, and engineering multiplier.">
  <section class="page-intro section-pad section-dark"><div class="container narrow"><p class="eyebrow">Resume</p><h1>Technology leader. Enterprise architect. Engineering multiplier.</h1><p class="lede">25+ years of experience building and modernizing mission-critical platforms, with deep recent expertise in payments, decisioning, fraud, and risk and broader leadership across distributed systems, enterprise platforms, cloud transformation, and applied AI.</p><div class="hero-actions"><a class="button button-light" href={resumePdf} download>Download Resume — PDF <span aria-hidden="true">↓</span></a><a class="text-link text-link-light" href={withBase("/Kavish-Agarwal-Resume.txt")} download>Plain-text resume <span aria-hidden="true">↓</span></a></div></div></section>
  <section class="section-pad"><div class="container"><div class="resume-grid"><div><p class="eyebrow">Profile</p><h2>Hands-on architecture with organizational scale.</h2></div><div class="prose"><p>I work at the intersection of hands-on architecture and organizational scale. My deepest recent work is in payments, real-time decisioning, fraud, and risk, while my broader career spans platform modernization, distributed systems, cloud architecture, enterprise applications, workflow and rules platforms, and applied AI across financial services, healthcare, retail, utilities, and travel.</p><p>A central theme of my leadership is creating leverage: reusable architecture, explicit engineering patterns, strong technical leaders, and teams that can make sound decisions independently.</p></div></div><div class="resume-focus-section"><p class="eyebrow">Core focus</p><div class="resume-focus-grid">{resumeFocusAreas.map((area) => <article><h3>{area.title}</h3><p>{area.details}</p></article>)}</div></div></div></section>
  <section class="section-pad section-tint"><div class="container"><p class="eyebrow">Experience</p><div class="resume-list">{resumeCareer.map((entry, index) => <article class:list={["resume-entry", { "resume-entry-primary": index < 2 }]}><div class="timeline-heading"><h3>{entry.company}</h3><span>{entry.period}</span></div><p class="timeline-title">{entry.title}</p><p>{entry.details}</p></article>)}</div></div></section>
  <section class="section-pad"><div class="container credentials-grid"><div><p class="eyebrow">Education & credentials</p><h2>Continued learning, kept practical.</h2></div><ul class="credential-list">{credentials.map((credential) => <li>{credential}</li>)}</ul></div></section>
</BaseLayout>
