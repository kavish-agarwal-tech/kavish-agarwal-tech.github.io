---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CareerJourney from "../components/CareerJourney.astro";
import { career, credentials } from "../data/content";
import { withBase } from "../utils/paths";
---
<BaseLayout title="About Kavish Agarwal" description="The career arc and working philosophy of Kavish Agarwal, a technology leader, enterprise architect, and engineering multiplier.">
  <section class="page-intro section-pad section-dark about-intro"><div class="container narrow"><p class="eyebrow">About</p><h1>Engineer → domain SME → technical lead → platform architect → enterprise technology leader.</h1><p class="lede">Technical depth creates credibility. Multiplying others creates scale.</p></div></section>
  <section class="section-pad"><div class="container about-grid"><div class="prose"><p>I am a technology leader and enterprise architect with 25+ years of experience building and modernizing financial platforms. My career has moved from hands-on engineering and decisioning-rule expertise into enterprise platform architecture, global engineering leadership, and organizational transformation—while staying close enough to the technology to prototype, debug, benchmark, and implement when the problem requires it.</p><p>A recurring theme in my work is turning complex, one-off solutions into reusable capabilities. I have helped modernize legacy financial systems, shape real-time fraud and risk decisioning platforms, design high-availability distributed architectures, guide cloud performance and cost optimization, and establish architecture practices that help multiple teams move with greater consistency and autonomy.</p><p>I am drawn to unfamiliar systems because making them understandable is often the beginning of making them better. I try to translate ambiguity into a clear set of choices, then create the context and ownership for others to carry the work forward.</p></div><aside class="about-aside"><p class="eyebrow">Working style</p><ul><li>Curious enough to learn the system deeply.</li><li>Pragmatic enough to preserve what works.</li><li>Direct enough to make tradeoffs visible.</li><li>Hands-on enough to test the idea.</li><li>Generous enough to teach it forward.</li></ul></aside></div></section>
  <section class="section-pad"><div class="container"><CareerJourney /></div></section>
  <section class="section-pad section-tint"><div class="container"><SectionHeading eyebrow="Career snapshot" title="A career built around increasingly larger systems." /><div class="timeline">{career.map((entry, index) => <article><div class="timeline-marker">0{index + 1}</div><div><div class="timeline-heading"><h3>{entry.company}</h3><span>{entry.period}</span></div><p class="timeline-title">{entry.title}</p><p>{entry.details}</p></div></article>)}</div><a class="text-link" href={withBase("/resume")}>See the full public chronology <span aria-hidden="true">↗</span></a></div></section>
  <section class="section-pad"><div class="container credentials-grid"><div><SectionHeading eyebrow="Credentials" title="A compact record of continued learning." /></div><ul class="credential-list">{credentials.map((credential) => <li>{credential}</li>)}</ul></div></section>
</BaseLayout>
